# .gitignore
# Node / npm
node_modules/
package-lock.json

# IDE / editor
.vscode/
.idea/
*.sublime-workspace

# System files
.DS_Store
Thumbs.db

# Backups and logs
backup_*/
*.log

# Firebase
.firebase/
.firebase/**

# Obsidian vault metadata
.obsidian/

# Sensitive credentials (kept for reference, never pushed)
archive/credenciales/

# Copilot conversations (private)
copilot/

# Deploy caches
hosting..cache
.vercel/

# AI agent ephemeral state (not project content)
.agents/
.claude/skills/
.opencode/skills/

# Embedded git repositories (do not track as submodule)
archive/proyectos-legacy/*/